# compose.example.yaml が読む変数の雛形。`.env` にコピーして値を入れる。
# `.env` はトークンを含むので追跡しない（.gitignore 済み）。

# ホスト側のデータ置き場。`<pool>` は環境ごとのプール名に読み替える
PAPERLESS_ROOT=/mnt/<pool>/paperless

# Paperless の実行ユーザー。consume の ACL で読み取りと削除を許可したユーザーに合わせる
USERMAP_UID=1000
USERMAP_GID=1000

# Paperless の Web UI を公開するホスト側のポート（LAN だけに公開する方法は docs/setup.md）
PAPERLESS_PORT=8000

# 利用者のタイムゾーン（IANA 名）。Paperless と ai-classifier の両方に渡す。ここでは中立な例として UTC にしてある
TZ=UTC

# 乱数で作った長い文字列を入れる（例: openssl rand -base64 48）
PAPERLESS_SECRET_KEY=change-me
DB_PASSWORD=change-me

# --- ai-classifier ---
# Paperless 上の専用ユーザーの API トークン（docs/setup.md の手順で発行する）
PAPERLESS_TOKEN=change-me
# `claude setup-token` で発行したトークン（有効期限は約 1 年）
CLAUDE_CODE_OAUTH_TOKEN=change-me
# 省略可。既定は INTERVAL=300（秒）、CLAUDE_MODEL=sonnet、CLAUDE_TIMEOUT=600（秒）
#INTERVAL=300
#CLAUDE_MODEL=sonnet
#CLAUDE_TIMEOUT=600
